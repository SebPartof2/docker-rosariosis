#!/bin/bash

echo "Copying RosarioSIS to /var/www/html/"
if [[ -e "/var/www/html/config.inc.php" ]]; then
    # Save existing config.inc.php file
    cp /var/www/html/config.inc.php /var/www/html/config.inc.php.tmp
fi

cp -r /usr/src/rosariosis/. /var/www/html/

if [[ -e "/var/www/html/config.inc.php.tmp" ]]; then
    # Restore user config.inc.php file
    mv /var/www/html/config.inc.php.tmp /var/www/html/config.inc.php
fi

# REST_API plugin secret.
# The config.inc.php above is preserved across restarts, so the define cannot
# live in conf/config.inc.php -- it would only ever apply to a fresh volume.
# Append it here instead, idempotently.
if [[ -n "$ROSARIO_REST_API_SECRET" ]]; then
    if grep -q "ROSARIO_REST_API_SECRET" /var/www/html/config.inc.php; then
        echo "REST_API secret already present in config.inc.php"
    else
        echo "Adding REST_API secret to config.inc.php"
        # Strip a trailing ?> if present, then append.
        sed -i -e 's/^[[:space:]]*?>[[:space:]]*$//' /var/www/html/config.inc.php
        printf "\ndefine( 'ROSARIO_REST_API_SECRET', '%s' );\n" \
            "$ROSARIO_REST_API_SECRET" >> /var/www/html/config.inc.php
    fi
else
    echo "ROSARIO_REST_API_SECRET not set, skipping REST_API config"
fi

# Time zone (in-world location), for config.inc.php files that predate it.
# Same reason as above: config.inc.php is preserved across restarts.
if grep -q '\$Timezone' /var/www/html/config.inc.php; then
    echo "Time zone already present in config.inc.php"
else
    echo "Adding time zone to config.inc.php"
    sed -i -e 's/^[[:space:]]*?>[[:space:]]*$//' /var/www/html/config.inc.php
    printf "\n\$Timezone = getenv( 'ROSARIOSIS_TIMEZONE' ) ? getenv( 'ROSARIOSIS_TIMEZONE' ) : 'America/Anchorage';\n" \
        >> /var/www/html/config.inc.php
fi

# Clerk plugin keys, as constants the plugin reads (plugins/Clerk/README.md).
# Same reason as above: config.inc.php is preserved across restarts. Unlike the
# REST_API secret, the block is rewritten on every start, so a changed or
# removed value is applied.
# Security: the values end up in PHP code. Only characters keys, IDs and URLs
# use are accepted, so a value can never close the string and inject code.
CLERK_BEGIN='// BEGIN Clerk plugin keys (bin/init, rewritten on every start)'
CLERK_END='// END Clerk plugin keys'
sed -i -e "\#^${CLERK_BEGIN}\$#,\#^${CLERK_END}\$#d" /var/www/html/config.inc.php
# Also any CLERK_ constant defined by hand: PHP keeps the first define of a
# constant, so an old one above the block would silently win.
sed -i -e "/^[[:space:]]*define([[:space:]]*['\"]CLERK_/d" /var/www/html/config.inc.php
clerk_defines=""
for name in CLERK_SECRET_KEY CLERK_FRONTEND_API CLERK_OAUTH_CLIENT_ID CLERK_OAUTH_CLIENT_SECRET CLERK_OAUTH_REDIRECT_URI; do
    value="${!name}"
    if [[ -z "$value" ]]; then
        continue
    fi
    if [[ ! "$value" =~ ^[A-Za-z0-9_.:/?=\&%+-]+$ ]]; then
        echo "WARNING: $name contains characters that are not allowed, skipping it" >&2
        continue
    fi
    clerk_defines+="define( '$name', '$value' );"$'\n'
done
if [[ -n "$clerk_defines" ]]; then
    echo "Writing Clerk plugin keys to config.inc.php"
    sed -i -e 's/^[[:space:]]*?>[[:space:]]*$//' /var/www/html/config.inc.php
    # Make sure the block starts on its own line.
    if [[ -n "$(tail -c 1 /var/www/html/config.inc.php)" ]]; then
        echo >> /var/www/html/config.inc.php
    fi
    printf "%s\n%s%s\n" "$CLERK_BEGIN" "$clerk_defines" "$CLERK_END" >> /var/www/html/config.inc.php
else
    echo "CLERK_* not set, skipping Clerk plugin keys"
fi

chown -R www-data:www-data /var/www/html

# config.inc.php holds the database password and API secrets:
# readable by Apache (www-data) only, not by other users of the container.
chmod 600 /var/www/html/config.inc.php

echo "Configuring locale"
if [ "$ROSARIOSIS_LANG" == "en_US" ]; then
    echo "Found "$ROSARIOSIS_LANG
else
    echo "Installing "$ROSARIOSIS_LANG
    echo $ROSARIOSIS_LANG'.UTF-8 UTF-8' >> /etc/locale.gen
    locale-gen
fi

set -e

# first arg is `-f` or `--some-option`
if [ "${1#-}" != "$1" ]; then
	set -- php "$@"
fi

exec "$@"
