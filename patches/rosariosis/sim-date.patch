diff --git a/functions/Date.php b/functions/Date.php
index 84931fd..2a16270 100644
--- a/functions/Date.php
+++ b/functions/Date.php
@@ -21,8 +21,64 @@
  */
 function DBDate()
 {
-	// ISO, eg. 2015-07-10.
-	return date( 'Y-m-d' );
+	// SIMDATE The school "today" is the sim date when one is set.
+	return SimDate();
+}
+
+/**
+ * SIMDATE Sim Date: the in-world "today" of a roleplay school.
+ *
+ * Set from the hidden Sim_Date/SimDate.php program, stored in the config table
+ * (SIM_DATE, SCHOOL_ID=0). Empty means use the real date.
+ * Config() loads the config table once per request, so this costs no extra query.
+ *
+ * Real event timestamps (logins, logs, created_at...) must keep using date() / CURRENT_TIMESTAMP.
+ *
+ * @see docs/sim-date.md
+ *
+ * @return string Sim date, or the real date if none is set. ISO, eg. 2015-07-10.
+ */
+function SimDate()
+{
+	static $valid = [];
+
+	if ( session_status() !== PHP_SESSION_ACTIVE )
+	{
+		// Too early for Config(), which needs the session.
+		return date( 'Y-m-d' );
+	}
+
+	$sim_date = (string) Config( 'SIM_DATE' );
+
+	if ( $sim_date === '' )
+	{
+		return date( 'Y-m-d' );
+	}
+
+	if ( ! isset( $valid[ $sim_date ] ) )
+	{
+		$valid[ $sim_date ] = SimDateIsValid( $sim_date );
+	}
+
+	// Never let an invalid value into SQL: fall back to the real date.
+	return $valid[ $sim_date ] ? $sim_date : date( 'Y-m-d' );
+}
+
+/**
+ * SIMDATE Is this a real calendar date in YYYY-MM-DD format?
+ *
+ * @param string $date Date.
+ *
+ * @return bool
+ */
+function SimDateIsValid( $date )
+{
+	if ( ! preg_match( '/^(\d{4})-(\d{2})-(\d{2})$/', (string) $date, $matches ) )
+	{
+		return false;
+	}
+
+	return checkdate( (int) $matches[2], (int) $matches[3], (int) $matches[1] );
 }
 
 
